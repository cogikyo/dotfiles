[Unit]
Description=Temporary shutdown log capture in EFI pstore
DefaultDependencies=no
After=systemd-journal-flush.service
Before=systemd-pstore.service sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=sh -c 'echo N >/sys/module/efi_pstore/parameters/pstore_disable'
ExecStart=sh -c 'echo Y >/sys/module/printk/parameters/always_kmsg_dump'
ExecStop=systemctl log-target kmsg

[Install]
WantedBy=sysinit.target
