#!/bin/sh
[ "$1" = nas-wake ] || exit 0

if ping -c 3 -W 2 -q 192.168.0.111 >/dev/null; then
    logger -t nas-wake "NAS answers ping; no wake sent"
    exit 0
fi
if wol -i 192.168.0.255 6c:1f:f7:ac:91:98 >/dev/null; then
    logger -t nas-wake "NAS silent 10 min after power returned; sent magic packet"
else
    logger -t nas-wake -p user.err "NAS silent; wol failed"
fi
