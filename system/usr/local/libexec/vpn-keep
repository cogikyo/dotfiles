#!/usr/bin/env bash
set -euo pipefail

exec 9</run/vpn-keep.lock
flock -n 9 || exit 0

rows=$(nmcli -g UUID,TYPE,AUTOCONNECT,ACTIVE connection show)
status=0
while IFS=: read -r uuid type autoconnect active; do
  [[ $type == vpn && $autoconnect == yes && $active == no ]] || continue
  nmcli connection up uuid "$uuid" </dev/null || status=1
done <<<"$rows"
exit "$status"
