pkgname=eww
pkgver=0.6.0.r91.g48f5aa8
pkgrel=1
pkgdesc='ElKowars wacky widgets, Wayland-only build with a 500ms EWW_CPU poll interval'
arch=('x86_64')
url='https://github.com/elkowar/eww'
license=('MIT')
depends=('cairo' 'gcc-libs' 'gdk-pixbuf2' 'glib2' 'glibc' 'gtk-layer-shell' 'gtk3'
         'libdbusmenu-gtk3' 'pango')
makedepends=('rust')
options=('!debug')
_commit=48f5aa8b379adf29da0b0bb9ca04164f65d8bdaa
source=("${pkgname}-${_commit}.tar.gz::https://github.com/elkowar/eww/archive/${_commit}.tar.gz"
        'poll-interval.patch')
sha256sums=('e319c60348a6b37d5c4c66634f843767d591e944b621c70f7ac19870f8dbc917'
            'ddcbf2a5c3d707cd306b3b37f93c003499cf45d52b05c579cdbf59c747111eaa')

prepare() {
    cd "eww-${_commit}"
    patch -Np1 -i "$srcdir/poll-interval.patch"
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "eww-${_commit}"
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --no-default-features --features=wayland
}

package() {
    cd "eww-${_commit}"
    install -Dm755 target/release/eww "$pkgdir/usr/bin/eww"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
