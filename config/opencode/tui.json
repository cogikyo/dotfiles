{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "vagari",
  "mouse": true,
  "diff_style": "auto",
  "scroll_speed": 3,
  "scroll_acceleration": {
    "enabled": true
  },
  "keybinds": {
    "leader": "ctrl+h",
    "command_list": "<leader>l",
    "tool_details": "ctrl+d",
    "session_parent": "up,ctrl+alt+up",
    "model_list": "<leader>m",
    "model_cycle_favorite": "ctrl+m",
    "variant_cycle": "ctrl+i",
    "theme_list": "<leader>_",
    "agent_list": "<leader>a",
    "session_list": "<leader>r",
    "status_view": "<leader>s",
    "messages_first": "ctrl+g",
    "messages_last": "ctrl+alt+g",
    "input_line_home": "home,ctrl+a",
    "input_line_end": "end,ctrl+e",
    "input_select_line_home": "shift+home,ctrl+shift+a",
    "input_select_line_end": "shift+end,ctrl+shift+e",
    "input_buffer_home": "alt+home",
    "input_buffer_end": "alt+end",
    "input_select_buffer_home": "alt+shift+home",
    "input_select_buffer_end": "alt+shift+end",
    "session_share": "none",
    "session_unshare": "none",
    "terminal_suspend": "none"
  }
}
