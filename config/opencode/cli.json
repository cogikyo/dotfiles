{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "vagari"
  },
  "tabs": {
    "mode": "off"
  },
  "keybinds": {
    "leader": "ctrl+h",
    "app.exit": "ctrl+c",
    "command.palette.show": "<leader>l",
    "theme.switch": "<leader>_",
    "opencode.status": "none",
    "session.list": "none",
    "open.menu": "none",
    "session.redo": "none",
    "session.verbosity.cycle": "ctrl+d",
    "session.background": "ctrl+q",
    "session.aside": "ctrl+b",
    "session.toggle.thinking": "<leader>t",
    "session.timeline": "<leader>g",
    "terminal.toggle": "none",
    "terminal.select": "none",
    "terminal.close": "none",
    "diff.open": "<leader>v",
    "session.move": "<leader>o",
    "session.messages_last_user": "none",
    "session.tab.history.forward": "none",
    "session.share": "none",
    "session.unshare": "none",
    "session.parent": "up,ctrl+alt+up",
    "model.list": "<leader>m",
    "model.cycle_favorite": "ctrl+m",
    "agent.list": "none",
    "variant.cycle": "ctrl+i",
    "session.first": "ctrl+g",
    "session.last": "ctrl+alt+g",
    "input.line.home": "home,ctrl+a",
    "input.line.end": "end,ctrl+e",
    "input.move.left": "left",
    "input.delete": "delete,shift+delete",
    "input.newline": "shift+return,alt+return,ctrl+j",
    "prompt.queue": "none",
    "input.select.line.home": "shift+home",
    "input.select.line.end": "shift+end",
    "input.buffer.home": "alt+home",
    "input.buffer.end": "alt+end",
    "input.select.buffer.home": "alt+shift+home",
    "input.select.buffer.end": "alt+shift+end",
    "terminal.suspend": "none"
  },
  "scroll": {
    "speed": 3,
    "acceleration": true
  },
  "diffs": {},
  "mouse": true,
  "plugins": [
    "-opencode.notifications",
    "-opencode.sidebar.mcp",
    "-opencode.sidebar.context",
    "-opencode.sidebar.footer",
    "-opencode.prompt.footer"
  ],
  "session": {
    "verbosity": "high",
    "thinking": "hide",
    "sidebar": "auto"
  }
}
