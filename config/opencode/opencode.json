    { "action": "shell", "resource": "gio trash *", "effect": "allow" },
    { "action": "shell", "resource": "chmod *", "effect": "allow" },
    { "action": "shell", "resource": "chown *", "effect": "allow" },
    { "action": "shell", "resource": "yay *", "effect": "deny" },
