{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "enabled_providers": ["anthropic", "openai", "xai", "opencode-go"],
  "model": "xai/grok-4.6",
  "small_model": "openai/gpt-5.6-luna-fast",
  "default_agent": "collab",
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true },
    "explore": { "disable": true },
    "general": { "disable": true }
  },
  "share": "manual",
  "snapshot": true,
  "lsp": false,
  "formatter": {
    "prettier": {
      "disabled": true
    }
  },
  "plugin": [
    "opencode-claude-auth@1.5.4",
    "file:///home/cullyn/dotfiles/config/opencode/plugins/delegate/index.ts",
    "file:///home/cullyn/dotfiles/config/opencode/plugins/usage/tool.ts",
    "file:///home/cullyn/dotfiles/config/opencode/plugins/hyprd/notify.ts",
    "file:///home/cullyn/dotfiles/config/opencode/plugins/hyprd/browser-isolation.ts",
    "file:///home/cullyn/dotfiles/config/opencode/plugins/opencode/tool-guard.ts",
    "file:///home/cullyn/dotfiles/config/opencode/plugins/opencode/spec-title.ts",
    [
      "file:///home/cullyn/dotfiles/config/opencode/plugins/opencode/media-context/prompt.ts",
      { "imageNames": { "enabled": true } }
    ]
  ],
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "options": {
            "serviceTier": "priority"
          }
        },
        "gpt-5.6-terra": {
          "options": {
            "serviceTier": "priority"
          }
        }
      }
    },
    "xai": {
      "models": {
        "grok-4.6": {
          "name": "Grok 4.6",
          "options": {
            "reasoningEffort": "medium"
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" }
          }
        }
      }
    },
    "opencode-go": {
      "models": {
        "k3": {
          "name": "Kimi K3",
          "reasoning": true,
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" }
          }
        },
        "grok-4.6": {
          "name": "Grok 4.6",
          "options": {
            "reasoningEffort": "medium"
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" }
          }
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "list": "allow",
    "todowrite": "allow",
    "question": "allow",
    "task": "allow",
    "chrome-devtools_*": "deny",
    "spec_title": "deny",
    "task_status": "allow",
    "external_directory": {
      "/": "deny",
      "/?": "deny",
      "~/**": "allow",
      "$HOME/**": "allow",
      "/home/cullyn/**": "allow",
      "/usr": "allow",
      "/usr/**": "allow",
      "/var/cache/pacman/pkg/**": "allow",
      "/home/cullyn/.ssh/**": "deny",
      "/home/cullyn/.gnupg/**": "deny",
      "/home/cullyn/.password-store/**": "deny",
      "/home/cullyn/.local/share/keyrings/**": "deny",
      "/run/user/1000/opencode": "allow",
      "/run/user/1000/opencode/**": "allow",
      "/tmp/**": "allow"
    },
    "doom_loop": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": {
      "*": "allow",
      "commit": "deny",
      "rebase": "deny"
    },
    "lsp": "deny",
    "grep": {
      "*": "allow",
      "/": "deny"
    },
    "bash": {
      "*": "allow",
      "rg *": "allow",
      "rm *": "deny",
      "sudo rm*": "deny",
      "trash *": "allow",
      "trash-put *": "allow",
      "gio trash *": "allow",
      "*git add*": "deny",
      "*git apply*": "deny",
      "*git am": "deny",
      "*git am *": "deny",
      "*git commit*": "deny",
      "*git push*": "deny",
      "*git pull*": "deny",
      "*git fetch*": "deny",
      "*git merge*": "deny",
      "*git merge-base*": "allow",
      "*git rebase*": "deny",
      "*git cherry-pick*": "deny",
      "*git revert*": "deny",
      "*git reset*": "deny",
      "*git checkout*": "deny",
      "*git switch*": "deny",
      "*git restore*": "deny",
      "*git stash*": "deny",
      "*git stash list*": "allow",
      "*git stash show*": "allow",
      "*git branch*": "deny",
      "*git branch": "allow",
      "*git branch --show-current*": "allow",
      "*git branch --list*": "allow",
      "*git branch -a*": "allow",
      "*git branch -r*": "allow",
      "*git branch -vv*": "allow",
      "*git tag*": "deny",
      "*git tag": "allow",
      "*git tag --list*": "allow",
      "*git tag -l*": "allow",
      "*git worktree*": "deny",
      "*git worktree list*": "allow",
      "*git clean*": "deny",
      "*git config*": "deny",
      "*git config --get*": "allow",
      "*git config --get-all*": "allow",
      "*git config --list*": "allow",
      "*git remote add*": "deny",
      "*git remote remove*": "deny",
      "*git remote rename*": "deny",
      "*git remote set-url*": "deny",
      "*git remote prune*": "deny",
      "*git submodule*": "deny",
      "*git notes*": "deny",
      "*git update-ref*": "deny",
      "*git update-index*": "deny",
      "*git filter-*": "deny",
      "*git reflog expire*": "deny",
      "gh *": "deny",
      "sudo *": "ask",
      "su *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "pacman *": "ask",
      "pacman -Q*": "allow",
      "pacman --query*": "allow",
      "pacman -F *": "allow",
      "pacman -Si *": "allow",
      "pacman -Ss *": "allow",
      "pacman -Sl *": "allow",
      "pacman -Sp *": "allow",
      "pacman --sync --info *": "allow",
      "pacman --sync --search *": "allow",
      "pacman --sync --list *": "allow",
      "pacman --sync --print *": "allow",
      "yay *": "ask",
      "paru *": "ask",
      "npm install*": "ask",
      "pnpm install*": "ask",
      "yarn install*": "ask",
      "ls \".yarn\"*": "allow",
      "yarn install --immutable*": "allow",
      "bun install*": "ask",
      "go install*": "ask",
      "go get*": "ask",
      "docker system prune*": "ask",
      "docker compose down*": "ask",
      "docker compose rm*": "ask",
      "docker compose pull*": "ask",
      "docker compose push*": "ask",
      "docker rm*": "ask",
      "docker rmi*": "ask",
      "docker volume rm*": "ask",
      "kubectl *": "ask",
      "helm *": "ask",
      "terraform apply*": "ask",
      "terraform destroy*": "ask",
      "grok *": "deny"
    }
  },
  "experimental": {
    "primary_tools": ["usage_status", "task_status"]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [".git/**", "node_modules/**", "dist/**", "build/**"]
  }
}
