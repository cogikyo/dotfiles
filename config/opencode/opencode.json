    { "action": "read", "resource": "/home/cullyn/.mozilla/firefox/**/key4.db", "effect": "deny" },
    { "action": "read", "resource": "/home/cullyn/.claude/.credentials.json", "effect": "deny" },
    { "action": "read", "resource": "/home/cullyn/.claude-cogikyo/.credentials.json", "effect": "deny" },
    { "action": "read", "resource": "/home/cullyn/.claude-cullyn/.credentials.json", "effect": "deny" },
    { "action": "read", "resource": "/home/cullyn/.local/share/opencode*/*auth.json", "effect": "deny" },
