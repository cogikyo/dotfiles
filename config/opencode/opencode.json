    { "action": "x", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "commit", "effect": "deny" },
    { "action": "skill", "resource": "rebase", "effect": "deny" },
    { "action": "skill", "resource": "worktrees", "effect": "deny" },
