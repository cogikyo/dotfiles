{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "anthropic-personal/claude-opus-5-5",
  "default_agent": "collab",
  "share": "manual",
  "snapshots": true,
  "lsp": false,
  "worktree": {
    "directory": ".worktrees"
  },
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "title": {
      "model": "openai/gpt-6-luna-fast",
      "system": "You are a title generator. You output ONLY a title. Nothing else.\n\nWrite a 2-4 word title that helps the user find this conversation later and names what it is working on.\nIf the request states its own word limit or format, follow the request instead.\n\nRules:\n- Output a single line with no explanation, quotes, markdown, or trailing punctuation.\n- Use the same language as the user messages.\n- Keep exact technical terms, numbers, filenames, and HTTP codes.\n- Never include tool names such as read, bash, or edit.\n- Never write the title in all capital letters; use normal or sentence case.\n- Never answer questions, use tools, or complain about the input.\n- For short or conversational input, name its tone or intent, such as Quick check-in.\n\nExamples:\n\"debug 500 errors in production\" -> Production 500 errors\n\"refactor user service\" -> User service refactor\n\"@src/auth.ts add refresh token support\" -> Auth refresh tokens\n\"how do I connect postgres to my API\" -> Postgres API connection"
    },
    "collab": {
      "description": "The human-facing primary agent. Owns conversation, planning, implementation, review, workflow approval, and Git work.",
      "mode": "primary",
      "model": "anthropic-personal/claude-opus-5-5#high",
      "color": "#f8b486",
      "system": "{file:./COLLAB.md}\n\nInstructions from: ROUTING.md\n{file:./ROUTING.md}",
      "permissions": [
        { "action": "usage_status", "resource": "*", "effect": "allow" },
        { "action": "lanes", "resource": "*", "effect": "allow" },
        { "action": "lanes_close", "resource": "*", "effect": "allow" },
        { "action": "x", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*git add .", "effect": "deny" },
        { "action": "shell", "resource": "*git add . *", "effect": "deny" },
        { "action": "shell", "resource": "*git add -- .", "effect": "deny" },
        { "action": "shell", "resource": "*git add -- . *", "effect": "deny" },
        { "action": "shell", "resource": "*git add -A*", "effect": "deny" },
        { "action": "shell", "resource": "*git add --all*", "effect": "deny" },
        { "action": "shell", "resource": "*git add -u*", "effect": "deny" },
        { "action": "shell", "resource": "*git add --update*", "effect": "deny" },
        { "action": "shell", "resource": "*git commit -a*", "effect": "deny" },
        { "action": "shell", "resource": "*git commit *--all*", "effect": "deny" },
        { "action": "shell", "resource": "*git commit *--no-verify*", "effect": "deny" },
        { "action": "shell", "resource": "*git commit *--allow-empty*", "effect": "deny" },
        { "action": "shell", "resource": "*git apply *--unsafe-paths*", "effect": "deny" },
        { "action": "shell", "resource": "*git reset --hard*", "effect": "deny" },
        { "action": "shell", "resource": "*git clean*", "effect": "deny" },
        { "action": "shell", "resource": "*git checkout -- .", "effect": "deny" },
        { "action": "shell", "resource": "*git checkout -- . *", "effect": "deny" },
        { "action": "shell", "resource": "*git restore -- .", "effect": "deny" },
        { "action": "shell", "resource": "*git restore -- . *", "effect": "deny" },
        { "action": "shell", "resource": "*git restore --worktree .", "effect": "deny" },
        { "action": "shell", "resource": "*git restore --worktree . *", "effect": "deny" },
        { "action": "shell", "resource": "*git restore --worktree -- .", "effect": "deny" },
        { "action": "shell", "resource": "*git restore --worktree -- . *", "effect": "deny" },
        { "action": "shell", "resource": "*git restore --staged --worktree .", "effect": "deny" },
        { "action": "shell", "resource": "*git restore --staged --worktree . *", "effect": "deny" },
        { "action": "shell", "resource": "*git restore --staged --worktree -- .", "effect": "deny" },
        { "action": "shell", "resource": "*git restore --staged --worktree -- . *", "effect": "deny" },
        { "action": "shell", "resource": "*git restore --worktree --staged .", "effect": "deny" },
        { "action": "shell", "resource": "*git restore --worktree --staged . *", "effect": "deny" },
        { "action": "shell", "resource": "*git restore --worktree --staged -- .", "effect": "deny" },
        { "action": "shell", "resource": "*git restore --worktree --staged -- . *", "effect": "deny" },
        { "action": "shell", "resource": "*git restore .", "effect": "deny" },
        { "action": "shell", "resource": "*git restore . *", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "allow" }
      ]
    }
  },
  "permissions": [
