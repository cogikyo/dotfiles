  "compaction": {
    "auto": true,
    "buffer": 25000
  },
  "formatter": {
    "prettier": {
      "disabled": true
    },
    "markdown": {
      "command": ["sh", "-c", "out=$(\"$HOME/.local/share/nvim/mason/bin/prettierd\" \"$1\" < \"$1\") && printf '%s\\n' \"$out\" > \"$1\"", "_", "$FILE"],
      "extensions": [".md"]
    }
  },
  "mcp": {
    "servers": {
      "clickhouse-docs": {
        "type": "remote",
        "url": "https://clickhouse.com/docs/mcp",
        "disabled": true,
        "oauth": false,
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        }
      }
    }
  },
  "websearch": {
    "provider": "exa"
  },
  "watcher": {
    "ignore": [".git/**", "node_modules/**", "dist/**", "build/**"]
  },
  "providers": {
    "anthropic": {
      "name": "Anthropic [Trend]",
      "settings": {
        "apiKey": "oauth-required"
      },
      "models": {
        "claude-opus-5-5": {
          "name": "Opus 5.5",
          "limit": { "input": 425000 }
        },
        "claude-sonnet-5-5": {
          "name": "Sonnet 5.5",
          "limit": { "input": 425000 }
        },
        "claude-fable-5-1": {
          "name": "Fable 5.1",
          "limit": { "input": 425000 }
        }
      }
    },
    "anthropic-personal": {
      "canonical": "anthropic",
      "name": "Anthropic [Cogikyo]",
      "settings": {
        "apiKey": "oauth-required"
      },
      "models": {
        "claude-opus-5-5": {
          "name": "Opus 5.5",
          "limit": { "input": 425000 }
        },
        "claude-sonnet-5-5": {
          "name": "Sonnet 5.5",
          "limit": { "input": 425000 }
        },
        "claude-fable-5-1": {
          "name": "Fable 5.1",
          "settings": {
            "thinking": {
              "type": "adaptive",
              "display": "summarized"
            },
            "effort": "medium"
          },
          "limit": { "input": 425000 }
        }
      }
    },
    "anthropic-cullyn": {
      "canonical": "anthropic",
      "name": "Anthropic [Cullyn]",
      "settings": {
        "apiKey": "oauth-required"
      },
      "models": {
        "claude-opus-5-5": {
          "name": "Opus 5.5",
          "limit": { "input": 425000 }
        },
        "claude-sonnet-5-5": {
          "name": "Sonnet 5.5",
          "limit": { "input": 425000 }
        },
        "claude-fable-5-1": {
          "name": "Fable 5.1",
          "settings": {
            "thinking": {
              "type": "adaptive",
              "display": "summarized"
            },
            "effort": "medium"
          },
          "limit": { "input": 425000 }
        }
      }
    },
    "cursor": {
      "name": "Cursor",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:3000/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "grok-4.6-fast": {
          "name": "Grok 4.6 Fast"
        },
        "claude-opus-5-5-fast": {
          "name": "Opus 5.5 Fast"
        }
      }
    },
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "name": "Sol",
          "settings": {
            "reasoningEffort": "high"
          },
          "limit": { "input": 425000 }
        },
        "gpt-6.1-sol-fast": {
          "name": "Sol Fast"
        },
        "gpt-6-astra": {
          "limit": { "input": 425000 }
        }
      }
    },
    "xai": {
      "models": {
        "grok-4.7": {
          "name": "Grok 4.7",
          "settings": {
