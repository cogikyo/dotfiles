    { "action": "read", "resource": "/home/cullyn/.local/state/opencode*/service*.json", "effect": "deny" },
    { "action": "external_directory", "resource": "/?", "effect": "deny" },
    { "action": "external_directory", "resource": "/home/cullyn/.ssh/**", "effect": "deny" },
    { "action": "external_directory", "resource": "/home/cullyn/.gnupg/**", "effect": "deny" },
    { "action": "external_directory", "resource": "/home/cullyn/.password-store/**", "effect": "deny" },
    { "action": "external_directory", "resource": "/home/cullyn/.local/share/keyrings/**", "effect": "deny" },
    { "action": "external_directory", "resource": "/home/cullyn/.local/.owm_api_key*", "effect": "deny" },
    { "action": "external_directory", "resource": "/home/cullyn/.local/share/dotfiles/cloudflare.env*", "effect": "deny" },
    { "action": "external_directory", "resource": "/home/cullyn/.local/share/dotfiles/vpn/**", "effect": "deny" },
    {
      "action": "external_directory",
      "resource": "/home/cullyn/.mozilla/firefox/**/cookies.sqlite*",
      "effect": "deny"
    },
    { "action": "external_directory", "resource": "/home/cullyn/.mozilla/firefox/**/logins.json", "effect": "deny" },
    { "action": "external_directory", "resource": "/home/cullyn/.mozilla/firefox/**/key4.db", "effect": "deny" },
    { "action": "chrome-devtools_*", "resource": "*", "effect": "deny" },
    { "action": "usage_status", "resource": "*", "effect": "deny" },
    { "action": "lanes", "resource": "*", "effect": "deny" },
