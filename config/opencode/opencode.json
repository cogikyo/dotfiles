      "name": "Anthropic [Cogikyo]",
      "options": { "apiKey": "oauth-required" },
      "models": {
        "claude-opus-5-5": {
          "name": "Claude Opus 5.5",
          "attachment": true,
          "reasoning": true,
          "modalities": { "input": ["text", "image", "pdf"] },
          "limit": { "context": 1000000, "output": 128000 },
          "variants": { "low": { "disabled": true }, "medium": { "disabled": true } }
