{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "blue",
      "purple",
      "green",
      "orange",
      "red",
      "cyan"
    ],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.slt.100",
      "faint": "$hue.slt.200",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.slt.100",
          "$focused": "$hue.neutral.800",
          "$selected": "$hue.orange.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base",
          "$focused": "$hue.neutral.800"
        },
        "destructive": {
          "base": "$hue.neutral.800",
          "$disabled": "$hue.slt.100"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.orange.200",
        "$focused": "$hue.orange.200",
        "$pressed": "$hue.orange.200",
        "$disabled": "$hue.slt.100",
        "$selected": "$hue.orange.200"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.200"
        },
        "warning": {
          "base": "$hue.blue.200"
        },
        "success": {
          "base": "$hue.green.200"
        },
        "info": {
          "base": "$hue.cyan.200"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.glc.500",
        "max": "$hue.glc.400"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.orange.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.200"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "$hue.glc.400"
    },
    "scrollbar": {
      "base": "$hue.orange.500"
    },
    "diff": {
      "text": {
        "added": "$hue.tyr.300",
        "removed": "$hue.his.300",
        "context": "$hue.slt.400",
        "hunkHeader": "$hue.sky.300"
      },
      "background": {
        "added": "$hue.olv.600",
        "removed": "$hue.plm.600",
        "context": "$hue.glc.600"
      },
      "highlight": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200"
      },
      "lineNumber": {
        "text": "$hue.slt.400",
        "background": {
          "added": "$hue.olv.600",
          "removed": "$hue.plm.600"
        }
      }
    },
    "syntax": {
      "comment": "$hue.slt.400",
      "keyword": "$hue.purple.300",
      "function": "$hue.orange.200",
      "variable": "$hue.neutral.200",
      "string": "$hue.grn.200",
      "number": "$hue.pnk.300",
      "type": "$hue.brt.300",
      "operator": "$hue.sky.100",
      "punctuation": "$hue.glu.200"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.orange.200",
      "link": "$hue.slt.400",
      "linkText": "$hue.brt.100",
      "code": "$hue.grn.100",
      "blockQuote": "$hue.slt.100",
      "emphasis": "$hue.blue.100",
      "strong": "$hue.brt.100",
      "horizontalRule": "$hue.glc.400",
      "listItem": "$hue.glu.200",
      "listEnumeration": "$hue.glu.200",
      "image": "$hue.sky.400",
      "imageText": "$hue.sky.400",
      "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
