; Upstream: https://github.com/GabePoel/KvLibadwaita
; SVG and kvconfig were generated by recoloring upstream colors to vagari roles.
[%General]
author=cullyn, from KvLibadwaita by GabePoel
comment=vagari palette on KvLibadwaita shapes
x11drag=menubar_and_primary_toolbar
mirror_doc_tabs=false
group_toolbar_buttons=true
toolbar_interior_spacing=2
spread_progressbar=true
composite=true
menu_shadow_depth=16
spread_menuitems=true
tooltip_shadow_depth=7
splitter_width=1
scroll_width=9
scroll_min_extent=60
slider_width=4
slider_handle_width=23
slider_handle_length=22
tickless_slider_handle_size=22
center_toolbar_handle=true
check_size=24
progressbar_thickness=2
toolbutton_style=1
spin_button_width=24
merge_menubar_with_toolbar=true
toolbar_icon_size=16
combo_as_lineedit=true
animate_states=true
combo_menu=true
hide_combo_checkboxes=true
groupbox_top_label=true
inline_spin_indicators=true
joined_inactive_tabs=false
layout_spacing=6
layout_margin=9
transient_scrollbar=true
transient_groove=true

[GeneralColors]
window.color=#222536
base.color=#222536
alt.base.color=#252841
button.color=#252841
light.color=#282b48
mid.light.color=#30345a
dark.color=#181b2c
mid.color=#282b48
shadow.color=#0d0f1b
highlight.color=#3f4578
inactive.highlight.color=#30345a
tooltip.base.color=#252841
text.color=#aeb9f8
window.text.color=#aeb9f8
button.text.color=#aeb9f8
disabled.text.color=#585f8d
tooltip.text.color=#aeb9f8
highlight.text.color=#bec6f8
link.color=#9db2f4
link.visited.color=#b29ae8
progress.indicator.text.color=#aeb9f8

[Hacks]
transparent_ktitle_label=true
transparent_dolphin_view=true
transparent_pcmanfm_sidepane=true
transparent_pcmanfm_view=true
transparent_menutitle=true
respect_darkness=true
iconless_pushbutton=true
normal_default_pushbutton=true
single_top_toolbar=true
no_selection_tint=true
transparent_arrow_button=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
interior=true
interior.element=button
indicator.size=8
text.normal.color=#aeb9f8
text.focus.color=#aeb9f8
text.press.color=#d1d8ff
text.toggle.color=#d1d8ff
text.margin=4
text.iconspacing=4
indicator.element=arrow

[PanelButtonTool]
inherits=PanelButtonCommand
indicator.size=0

[ToolbarButton]
frame.element=tbutton
interior.element=tbutton
indicator.element=tarrow
text.normal.color=#aeb9f8
text.focus.color=#aeb9f8
text.press.color=#d1d8ff
text.toggle.color=#d1d8ff

[Dock]
inherits=PanelButtonCommand
interior.element=dock
frame.element=dock
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
indicator.element=spin
text.margin.top=2
text.margin.bottom=2
text.margin.left=2
text.margin.right=2

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.focus.color=#aeb9f8
text.press.color=#aeb9f8
text.toggle.color=#aeb9f8
min_width=+0.3font
min_height=+0.3font

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.focus.color=#aeb9f8
text.press.color=#aeb9f8
text.toggle.color=#aeb9f8
min_width=+0.3font
min_height=+0.3font

[Focus]
inherits=PanelButtonCommand
frame.element=focus
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[GenericFrame]
inherits=PanelButtonCommand
interior=false
frame.element=common
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
text.margin.top=2
text.margin.bottom=2
text.margin.left=2
text.margin.right=2

[ToolbarLineEdit]
frame.element=lineedit
interior.element=lineedit

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.size=8

[ToolboxTab]
inherits=PanelButtonCommand
text.press.color=#aeb9f8

[Tab]
inherits=PanelButtonCommand
interior.element=tab
text.margin.top=0
text.margin.bottom=0
frame.element=tab
indicator.element=tab
indicator.size=22
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8
text.focus.color=#f8b486
text.press.color=#7492ef
text.toggle.color=#7492ef

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior.element=tabframe
frame.top=24
frame.bottom=24
frame.left=24
frame.right=24

[TreeExpander]
inherits=PanelButtonCommand
indicator.element=tree

[HeaderSection]
inherits=PanelButtonCommand
interior.element=header
frame.element=header
frame.top=0
frame.bottom=1
frame.left=1
frame.right=1
text.press.color=#bec6f8
text.toggle.color=#bec6f8

[SizeGrip]
indicator.element=resize-grip

[Toolbar]
inherits=PanelButtonCommand
indicator.element=toolbar
indicator.size=5
text.margin=0
interior.element=menubar
frame.element=menubar
text.press.color=#aeb9f8
text.toggle.color=#bec6f8
frame.top=0
frame.bottom=1

[Slider]
inherits=PanelButtonCommand
frame.element=slider
focusFrame=true
interior.element=slider
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
text.margin=0
text.focus.color=#aeb9f8
text.press.color=#aeb9f8
text.toggle.color=#aeb9f8
frame.expansion=8

[ProgressbarContents]
inherits=PanelButtonCommand
frame.element=progress-pattern
interior.element=progress-pattern

[ItemView]
inherits=PanelButtonCommand
text.margin=0
frame.element=itemview
interior.element=itemview
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.focus.color=#f8b486
text.press.color=#7492ef
text.toggle.color=#7492ef
min_width=+0.3font
min_height=+0.3font

[Splitter]
frame=false
indicator.size=0

[Scrollbar]
inherits=PanelButtonCommand
indicator.size=12

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior=false
frame.left=5
frame.right=5
frame.top=5
frame.bottom=5
indicator.element=grip
indicator.size=12

[ScrollbarGroove]
inherits=PanelButtonCommand
interior=false
frame=false

[Menu]
inherits=PanelButtonCommand
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8
frame.element=menu
interior.element=menu

[MenuItem]
inherits=PanelButtonCommand
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
text.margin.top=0
text.margin.bottom=0
text.margin.left=6
text.margin.right=6
frame.top=4
frame.bottom=4
frame.left=12
frame.right=12
text.focus.color=#f8b486

[MenuBar]
inherits=PanelButtonCommand
frame.element=menubar
interior.element=menubar
frame.bottom=0
text.press.color=#bec6f8
text.toggle.color=#bec6f8

[MenuBarItem]
inherits=PanelButtonCommand
interior.element=menubaritem
frame.element=menubaritem
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin.top=0
text.margin.bottom=0
text.focus.color=#f8b486
text.press.color=#bec6f8
text.toggle.color=#bec6f8
min_width=+0.3font
min_height=+0.3font

[TitleBar]
inherits=PanelButtonCommand
frame=false
text.margin.left=2
text.margin.right=2
interior.element=titlebar
indicator.size=16
indicator.element=mdi
text.normal.color=#7b7fb0
text.focus.color=#aeb9f8

[ComboBox]
inherits=PanelButtonCommand
frame.element=combo
interior.element=combo
text.margin.top=2
text.margin.bottom=2
text.margin.left=2
text.margin.right=2
text.press.color=#aeb9f8
text.toggle.color=#bec6f8

[GroupBox]
inherits=GenericFrame
frame=false
text.margin=0

[TabBarFrame]
inherits=GenericFrame
frame=false

[ToolTip]
inherits=GenericFrame
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
interior=true
interior.element=tooltip
frame.element=tooltip
frame.expansion=6

[StatusBar]
inherits=GenericFrame
frame=false

[Window]
interior=true
interior.element=window
frame=true
frame.element=window
frame.bottom=10
frame.top=10
