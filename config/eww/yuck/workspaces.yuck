(defwindow workspaces
  :monitor 0 :stacking "bottom" :exclusive false :focusable false
  :geometry (geometry :anchor "top right" :x "0px" :y "0px")
  (workspaces)
)

(defvar ws-h1 false)
(defvar ws-h2 false)
(defvar ws-h3 false)
(defvar ws-h4 false)
(defvar ws-h5 false)
(defvar ws-h6 false)

(deflisten workspace-info
  :initial '{"current":5,"current_str":"5","occupied":[5],"occupied_str":"5","attention":[],"attention_str":"","arrival":""}'
  'hyprd subscribe workspace | jq --unbuffered -c ".data"'
)

(defwidget workspace [num desc hover ?state]
  (eventbox
    :onhover "eww update ws-h${num}=true"
    :onhoverlost "eww update ws-h${num}=false"
    :onclick "hyprd ws ${num} & disown"
    :cursor "pointer"
    :onmiddleclick "hyprd ws ${num} & disown"
    :tooltip "  ${desc} · 󰳽/ǂ switch  "
    (box
      :class "workspace ws-${num} ${
                workspace-info.current_str == num ? "ws-current" :
                matches(workspace-info.occupied_str, "${num}") ? "ws-occupied" :
                "ws-empty"
              } ${hover ? "ws-hover" : ""} ${state}"
      (children)
    )
  )
)

(defwidget ws-icon [name]
  (image :class name :icon "ws-${name}-symbolic" :icon-size "dnd")
)

(defwidget workspaces []
  (eventbox
    :onhover "eww update hover=workspaces"
    :onhoverlost "eww update hover='' ws-h1=false ws-h2=false ws-h3=false ws-h4=false ws-h5=false ws-h6=false"
    :onrightclick "hyprctl dispatch workspace previous"
    :tooltip "  󰮫 󰳾 previous workspace  "
    (workspace-list
      :class "tr-a workspacesbox ${hover == "workspaces" ? "workspacesbox-hover" : ""}"
      :orientation "vertical"
    )
  )
)

(defwidget workspace-list [class orientation]
  (box
    :class class
    :halign "center" :space-evenly false
    :orientation orientation
    (workspace :num "1" :hover ws-h1 :desc "󰭹 chat"
      :state "${matches(workspace-info.attention_str ?: "", "grok-bot") ? "ws-grok" : ""} ${
               matches(workspace-info.attention_str ?: "", "slack") ? "ws-slack" : ""} ${
               matches(workspace-info.attention_str ?: "", "firefox") ? "ws-firefox" : ""} ${
               matches(workspace-info.arrival ?: "", "grok-bot") ? "ws-from-grok" :
               matches(workspace-info.arrival ?: "", "slack") ? "ws-from-slack" :
               matches(workspace-info.arrival ?: "", "firefox") ? "ws-from-firefox" : ""}"
      (overlay
        (ws-icon :name "network-edge-1")
        (ws-icon :name "network-edge-2")
        (ws-icon :name "network-edge-3")
        (ws-icon :name "network-edge-4")
        (ws-icon :name "network-edge-5")
        (ws-icon :name "network-hub")
        (ws-icon :name "network-node-1")
        (ws-icon :name "network-node-2")
        (ws-icon :name "network-node-3")
        (ws-icon :name "network-node-4")
        (ws-icon :name "network-node-5")
      )
    )
    (workspace :num "2" :hover ws-h2 :desc " misc"
      (ws-icon :name "learn"))
    (workspace :num "3" :hover ws-h3 :desc "󰃖 work"
      (overlay
        (ws-icon :name "leadpier-left")
        (ws-icon :name "leadpier-right")
        (ws-icon :name "leadpier-left-rim")
        (ws-icon :name "leadpier-right-rim")
      )
    )
    (workspace :num "4" :hover ws-h4 :desc "󰀄 personal"
      (ws-icon :name "dna"))
    (workspace :num "5" :hover ws-h5 :desc " dotfiles"
      (overlay
        (ws-icon :name "dotfiles-cog")
        (ws-icon :name "dotfiles-gear")
        (ws-icon :name "dotfiles-lens")
      )
    )
    (workspace :num "6" :hover ws-h6 :desc " music"
      :state {pctl.playing ? "ws-playing" : ""}
      (ws-icon :name "music"))
  )
)
