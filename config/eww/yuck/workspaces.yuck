(defwindow workspaces
  ; Disable resizing so GTK can shrink the window after CSS reloads.
  :monitor 0 :stacking "bottom" :exclusive false :focusable false :resizable false
  :geometry (geometry :anchor "top right" :x "0px" :y "0px")
  (workspaces :compact false)
)

(defvar ws-h1 false)
(defvar ws-h2 false)
(defvar ws-h3 false)
(defvar ws-h4 false)
(defvar ws-h5 false)
(defvar ws-h6 false)
(defvar ws-dur "0ms")

(deflisten workspace-info
  :initial '{"current":5,"current_str":"5","occupied":[5],"occupied_str":"5","attention":[],"attention_str":"","arrival":""}'
  'hyprd subscribe workspace | jq --unbuffered -c ".data"'
)

(defwidget workspace [num hovered compact ?state]
  (eventbox
    :onhover "eww update ws-h${num}=true"
    :onhoverlost "eww update ws-h${num}=false"
    :onclick "hyprd ws ${num} & disown"
    :cursor "pointer"
    :onmiddleclick "hyprd ws ${num} & disown"
    (revealer
      :transition "slideleft"
      :duration {compact ? (hover == "workspaces" ? "500ms" : ws-dur) : "500ms"}
      :reveal {!compact || workspace-info.current_str == num || hover == "workspaces"}
      (box
        :class "workspace ws-${num} ${
                  workspace-info.current_str == num ? "ws-current" :
                  matches(workspace-info.occupied_str, "${num}") ? "ws-occupied" :
                  "ws-empty"
                } ${hovered ? "ws-hover" : ""} ${state}"
        (children)
      )
    )
  )
)

(defwidget ws-icon [name compact]
  (image :class name :icon "ws-${name}-symbolic" :icon-size {compact ? "large-toolbar" : "dnd"})
)

(defwidget workspaces [compact]
  (tip :compact compact :text "  󰮫 󰳾 previous workspace  "
    (eventbox
      :timeout {compact ? "1s" : "200ms"}
      :onhover "eww update hover=workspaces${compact ? " ws-dur=0ms" : ""}"
      :onhoverlost "${compact ? "eww update ws-dur=500ms; " : ""}eww update hover='' ws-h1=false ws-h2=false ws-h3=false ws-h4=false ws-h5=false ws-h6=false${compact ? "; (sleep 0.6; eww update ws-dur=0ms) &" : ""}"
      :onrightclick "hyprctl dispatch workspace previous"
      (box
        :class "${compact ? "tr-a computerbox bar-edge" : "workspacesbox"} ${
                  hover != "workspaces" ? "" : compact ? "computerbox-hover" : "workspacesbox-hover"
                }"
        :halign "center" :space-evenly false
        :orientation {compact ? "horizontal" : "vertical"}
        (tip :compact compact :text "  󰭹 chat · 󰳽/ǂ switch  "
          (workspace :num "1" :hovered ws-h1 :compact compact
            :state "${matches(workspace-info.attention_str ?: "", "grok-bot") ? "ws-grok" : ""} ${
                     matches(workspace-info.attention_str ?: "", "slack") ? "ws-slack" : ""} ${
                     matches(workspace-info.attention_str ?: "", "firefox") ? "ws-firefox" : ""} ${
                     matches(workspace-info.arrival ?: "", "grok-bot") ? "ws-from-grok" :
                     matches(workspace-info.arrival ?: "", "slack") ? "ws-from-slack" :
                     matches(workspace-info.arrival ?: "", "firefox") ? "ws-from-firefox" : ""}"
            (overlay
              (ws-icon :name "network-edge-1" :compact compact)
              (ws-icon :name "network-edge-2" :compact compact)
              (ws-icon :name "network-edge-3" :compact compact)
              (ws-icon :name "network-edge-4" :compact compact)
              (ws-icon :name "network-edge-5" :compact compact)
              (ws-icon :name "network-hub" :compact compact)
              (ws-icon :name "network-node-1" :compact compact)
              (ws-icon :name "network-node-2" :compact compact)
              (ws-icon :name "network-node-3" :compact compact)
              (ws-icon :name "network-node-4" :compact compact)
              (ws-icon :name "network-node-5" :compact compact)
            )
          )
        )
        (tip :compact compact :text "   misc · 󰳽/ǂ switch  "
          (workspace :num "2" :hovered ws-h2 :compact compact
            (ws-icon :name "learn" :compact compact))
        )
        (tip :compact compact :text "  󰃖 work · 󰳽/ǂ switch  "
          (workspace :num "3" :hovered ws-h3 :compact compact
            (overlay
              (ws-icon :name "leadpier-left" :compact compact)
              (ws-icon :name "leadpier-right" :compact compact)
              (ws-icon :name "leadpier-left-rim" :compact compact)
              (ws-icon :name "leadpier-right-rim" :compact compact)
            )
          )
        )
        (tip :compact compact :text "  󰀄 personal · 󰳽/ǂ switch  "
          (workspace :num "4" :hovered ws-h4 :compact compact
            (ws-icon :name "dna" :compact compact))
        )
        (tip :compact compact :text "   dotfiles · 󰳽/ǂ switch  "
          (workspace :num "5" :hovered ws-h5 :compact compact
            (overlay
              (ws-icon :name "dotfiles-cog" :compact compact)
              (ws-icon :name "dotfiles-gear" :compact compact)
              (ws-icon :name "dotfiles-lens" :compact compact)
            )
          )
        )
        (tip :compact compact :text "   music · 󰳽/ǂ switch  "
          (workspace :num "6" :hovered ws-h6 :compact compact
            :state {pctl.playing ? "ws-playing" : ""}
            (ws-icon :name "music" :compact compact))
        )
      )
    )
  )
)
