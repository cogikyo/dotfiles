(defwindow bar
  :monitor 0 :stacking "bottom" :exclusive false :focusable false
  :geometry (geometry :anchor "top center" :width "100%" :height "40px")
  (centerbox :class "bar"
    (box :class "bar-side" :valign "start" :space-evenly false
      (music :compact true)
      (audio :compact true)
      (box :hexpand true :halign "end" (weather :compact true))
    )
    (time :compact true)
    (box :class "bar-side" :valign "start" :space-evenly false
      (date :compact true)
      (box :hexpand true :halign "end" :space-evenly false
        (eventbox
          :onhover "eww update hover=computer"
          :onhoverlost "eww update hover=''"
          (box
            :class "computerbox ${hover == "computer" ? "computerbox-hover" : ""}"
            :space-evenly false
            (network :compact true :key "computer")
            (box :class "gap" (cpu :compact true :key "computer"))
            (box :class "gap" (memory :compact true :key "computer"))
          )
        )
        (workspaces :compact true)
      )
    )
  )
)
