;; ============================================================================
;; shared variables + widgets

(deflisten cycle-6
  :initial 0
  'ewwd subscribe cycle-6 | jq --unbuffered -c ".data"'
)

(deflisten cycle-5
  :initial 0
  'ewwd subscribe cycle-5 | jq --unbuffered -c ".data"'
)

(defvar browser "firefox-developer-edition")
(defvar terminal "kitty")
(defvar hover "")

(defwidget slide-n-fade [direction bool]
  (revealer
    :transition "slide${direction}"
    :reveal bool
    (revealer
      :transition "crossfade"
      :reveal bool
      (children)
    )
  )
)
