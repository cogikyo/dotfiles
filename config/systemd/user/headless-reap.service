[Unit]
Description=Kill headless browsers older than 3 hours

[Service]
Type=oneshot
Environment="PATTERN=^[^ ]*/((chromium|chrome|firefox) (.* )?--?headless(=[^ ]*)?|headless_shell|chrome-headless-shell)( |$)"
ExecStart=/usr/bin/pgrep --older 10800 -u %U -af ${PATTERN}
ExecStart=/usr/bin/pkill --older 10800 -u %U -ef ${PATTERN}
SuccessExitStatus=1
