[Unit]
Description=Snapcast client playing to the TV over HDMI
After=pipewire.service snapserver.service
BindsTo=pipewire.service
ConditionHost=costello

[Service]
# Keep this stream pinned to HDMI; falling back to snapcast creates an audio loop.
Environment="PIPEWIRE_PROPS={ node.name = snapclient-tv cogikyo.duck = skip target.object = alsa_output.pci-0000_c2_00.1.hdmi-stereo-extra1 node.dont-fallback = true node.dont-move = true node.linger = true }"
ExecStart=/usr/bin/snapclient --hostID costello-tv --player pipewire --logfilter *:notice tcp://127.0.0.1:1704
Restart=on-failure
TimeoutStopSec=3
Slice=session.slice

[Install]
WantedBy=pipewire.service
