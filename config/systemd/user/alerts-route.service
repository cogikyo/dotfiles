[Unit]
Description=Play alerts on HDMI while snapcast is the default sink, else on the default sink
After=pipewire.service pipewire-alerts.service
BindsTo=pipewire.service
ConditionHost=costello

[Service]
ExecStart=%h/.config/systemd/user/alerts-route
Restart=always
RestartSec=2

[Install]
WantedBy=pipewire.service
